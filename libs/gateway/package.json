  },
  "dependencies": {
    "@intentra/contracts": "workspace:*",
    "@nestjs/common": "catalog:nestjs12",
    "@nestjs/core": "catalog:nestjs12"
  },
  "nx": {
    "tags": ["type:gateway", "deployment:monolith"]
  }
}
