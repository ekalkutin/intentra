{
  "name": "@intentra/api-ports",
  "version": "0.0.0",
  "private": true,
  "description": "Клиентские порты: опубликованный API глазами потребителя. Реализацию подставляет композиционный корень",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "nx": {
    "tags": [
      "type:contracts",
      "deployment:monolith",
      "deployment:microservices"
    ]
  },
  "dependencies": {
    "@intentra/iam-contracts": "workspace:*",
    "@intentra/workspace-contracts": "workspace:*"
  }
}
