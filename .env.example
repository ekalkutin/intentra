# Used for MongoDB initialization in docker

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me
DB_URI=mongodb://root:change-me@localhost:27017/intentra?authSource=admin&replicaSet=rs0&directConnection=true
PORT=3000

# Required by the IAM context. Use strong, distinct values outside local development.
IAM_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
IAM_REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret
# Optional. Defaults: 15 minutes and 7 days.
IAM_ACCESS_TOKEN_TTL_SECONDS=900
IAM_REFRESH_TOKEN_TTL_SECONDS=604800

# Optional, all three or none. On start, the Account with this email becomes the only Platform Admin (runs Intentra: its Agents, Workspaces, Accounts);
# any other is dismissed, and with neither set nobody is one.
# A missing Account is created with this name and password; an existing one keeps its own.
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_NAME=Platform Admin
# PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# Required. Encrypts each Workspace's Provider Key (its own OpenRouter key, added by an Owner). 32 random bytes in base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes the stored keys unreadable: every Owner would have to add theirs again.
PROVIDER_KEY_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
