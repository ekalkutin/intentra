MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me

DB_URI=mongodb://root:change-me@localhost:27017/intentra?authSource=admin&replicaSet=rs0&directConnection=true

IAM_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
IAM_REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret
# IAM_ACCESS_TOKEN_TTL_SECONDS=900
# IAM_REFRESH_TOKEN_TTL_SECONDS=604800

# All three or none
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_NAME=Platform Admin
# PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# 32 random bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_KEY_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64

# INTENTRA_API_URL=http://localhost:3000
