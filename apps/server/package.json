{
  "name": "@intentra/server",
  "version": "0.0.0",
  "private": true,
  "description": "Композиционный корень: один процесс, в котором живут контексты и фасад",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "node --watch --enable-source-maps build/main.js",
    "start": "node --enable-source-maps build/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "nx": {
    "tags": [
      "type:app",
      "deployment:monolith"
    ]
  },
  "dependencies": {
    "@intentra/api-ports": "workspace:*",
    "@intentra/gateway": "workspace:*",
    "@intentra/iam": "workspace:*",
    "@intentra/workspace": "workspace:*",
    "@nestjs/common": "catalog:nestjs12",
    "@nestjs/config": "catalog:nestjs12",
    "@nestjs/core": "catalog:nestjs12",
    "@nestjs/platform-express": "catalog:nestjs12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "catalog:nestjs12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling"
  }
}
