PORT=3000
WEB_URL=http://localhost:5173

# Один инстанс Postgres, по базе на контекст.
DB_HOST=localhost
DB_PORT=10600
DB_USERNAME=postgres
DB_PASSWORD=change-me
IAM_DB=iam
WORKSPACE_DB=workspace

# Не менее 32 символов. Значения по умолчанию нет намеренно.
JWT_SECRET=replace-me-with-at-least-32-characters
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
