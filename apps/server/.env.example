DB_URI=mongodb://root:change-me@localhost:27017/intentra?authSource=admin
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
# Encrypts the OpenRouter keys of workspaces. Generate with: openssl rand -base64 32
AGENTS_SECRETS_KEY=change-me-to-32-random-bytes-in-base64
# The OpenRouter model a new orchestrator starts on
AGENTS_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
