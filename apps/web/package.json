    "preview": "vite preview",
    "codegen": "graphql-codegen --config src/app/codegen.ts",
    "codegen:w": "pnpm codegen --watch"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/near-operation-file-preset": "^5.2.2",
    "@graphql-codegen/typed-document-node": "^7.1.0",
