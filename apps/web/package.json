{
  "name": "@intentra/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "nx": {
    "tags": [
      "type:app",
      "deployment:monolith",
      "runtime:browser"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
