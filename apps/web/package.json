    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
