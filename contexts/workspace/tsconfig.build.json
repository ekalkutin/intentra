{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./build",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "tsBuildInfoFile": "./build/.tsbuildinfo"
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": [
    "build",
    "node_modules",
    "src/**/*.spec.ts",
    "src/**/migrations/**"
  ]
}
