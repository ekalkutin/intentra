// use prisma-8

model Workspace {
  id   Uuid   @id
  name String

  @@map("workspaces")
}

enum RoleScope {
  workspace
  project
}

model Role {
  id          Uuid       @id
  workspaceId Uuid?      @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  scope       RoleScope
  name        String

  @@unique([workspaceId, scope, name])
  @@map("roles")
}

model Member {
  id          Uuid      @id
  workspaceId Uuid      @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  accountId   Uuid      @map("account_id")
  roleId      Uuid      @map("role_id")
  role        Role      @relation(fields: [roleId], references: [id])

  projects    ProjectMember[]

  @@unique([workspaceId, accountId])
  @@map("members")
}

model Project {
  id          Uuid      @id
  workspaceId Uuid      @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  description String?

  members     ProjectMember[]

  @@map("projects")
}

model ProjectMember {
  projectId Uuid    @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  memberId  Uuid    @map("member_id")
  member    Member  @relation(fields: [memberId], references: [id])

  roleId    Uuid    @map("role_id")
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([projectId, memberId])
  @@map("project_members")
}
