{
  "name": "@intentra/agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate --advance-ref db",
    "migration:plan": "prisma migration plan"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@intentra/agent-surface": "workspace:*",
    "@intentra/contracts": "workspace:*",
    "@intentra/shared": "workspace:*",
    "@nestjs/common": "catalog:nestjs12",
    "@prisma/orm-postgres": "catalog:prisma8"
  },
  "devDependencies": {
    "@prisma/cli-engine": "catalog:prisma8",
    "prisma": "catalog:prisma8"
  },
  "nx": {
    "tags": [
      "type:context",
      "deployment:monolith",
      "deployment:microservices"
    ]
  }
}
