// use prisma-8

model AgentProfile {
  id            Uuid            @id
  // A workspace lives in another context's database: no foreign key.
  workspaceId   Uuid            @map("workspace_id")
  name          String
  instructions  String
  modelProvider String          @map("model_provider")
  modelName     String          @map("model_name")
  tools         String[]
  archivedAt    Timestamptz(3)? @map("archived_at")

  @@index([workspaceId])
  @@map("agent_profiles")
}
