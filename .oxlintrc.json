{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/build/**",
    "node_modules/**",
    "**/generated/**",
    "**/*.generated.ts",
    "**/__generated__/**",
    "apps/web/src/shared/ui/primitives/**"
  ],
  "plugins": [
    "import",
    "typescript",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/newline-after-import": "error",
    "typescript/no-empty-object-type": "off",
    "typescript/ban-ts-comment": "off",
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "no-console": "warn",
    "unicorn/no-empty-file": "warn"
  },
  "overrides": [
    {
      "files": [
        "libs/shared-kernel/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**"
                ],
                "message": "The shared kernel is the bottom of the stack and depends on nothing in the workspace."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "libs/shared-kernel/src/domain/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**"
                ],
                "message": "The shared kernel is the bottom of the stack and depends on nothing in the workspace."
              },
              {
                "group": [
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The domain is the centre of the hexagon: nothing inside it may know a use case, a vendor or a transport. Dependencies point inward."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "libs/shared-kernel/src/application/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**"
                ],
                "message": "The shared kernel is the bottom of the stack and depends on nothing in the workspace."
              },
              {
                "group": [
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "libs/contracts/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**"
                ],
                "message": "Contracts are shared with the frontend: zod schemas and types only. A contract that reaches for another workspace package (even the shared kernel, which uses node:crypto) no longer builds for the browser."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**"
                ],
                "message": "A context may depend only on contracts and the shared kernel. Contexts integrate through published events, not through each other's packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/**/*.spec.ts",
        "packages/**/*.fixtures.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**",
                  "!@intentra/platform-testing"
                ],
                "message": "A context may depend only on contracts and the shared kernel; its tests and test fixtures may also use the platform testing harness. Contexts integrate through published events, not through each other's packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**/domain/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**"
                ],
                "message": "A context may depend only on contracts and the shared kernel. Contexts integrate through published events, not through each other's packages."
              },
              {
                "group": [
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The domain is the centre of the hexagon: nothing inside it may know a use case, a vendor or a transport. Dependencies point inward."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**/application/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**"
                ],
                "message": "A context may depend only on contracts and the shared kernel. Contexts integrate through published events, not through each other's packages."
              },
              {
                "group": [
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**/application/**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**",
                  "!@intentra/platform-testing"
                ],
                "message": "A context may depend only on contracts and the shared kernel; its tests may also use the platform testing harness. Contexts integrate through published events, not through each other's packages."
              },
              {
                "group": [
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**/infrastructure/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**",
                  "!@intentra/platform-persistence",
                  "!@intentra/platform-testing"
                ],
                "message": "A context may depend only on contracts and the shared kernel; its infrastructure may also use the platform persistence adapters, and its tests the platform testing harness. Contexts integrate through published events, not through each other's packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/workspace/src/subdomains/agents/infrastructure/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared-kernel",
                  "!@intentra/contracts",
                  "!@intentra/contracts/**",
                  "!@intentra/platform-persistence",
                  "!@intentra/platform-testing",
                  "!@intentra/agent-toolkit"
                ],
                "message": "A context may depend only on contracts and the shared kernel; its infrastructure may also use the platform persistence adapters, and its tests the platform testing harness. Contexts integrate through published events, not through each other's packages. The Agents subdomain runs its Agents with @intentra/agent-toolkit (packages/workspace/src/subdomains/agents/docs/adr/0002-agents-run-the-orchestrator-through-agent-toolkit.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
