{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/build/**",
    "node_modules/**",
    "**/generated/**",
    "**/*.generated.ts"
  ],
  "plugins": ["import", "typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/newline-after-import": "error",
    "typescript/no-empty-object-type": "off",
    "typescript/ban-ts-comment": "off",
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "no-console": "warn",
    "unicorn/no-empty-file": "warn"
  },
  "overrides": [
    {
      "files": ["libs/shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@intentra/**"],
                "message": "The shared kernel is the bottom of the stack and depends on nothing in the workspace."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/shared/src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@intentra/**"],
                "message": "The shared kernel is the bottom of the stack and depends on nothing in the workspace."
              },
              {
                "group": [
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The domain is the centre of the hexagon: nothing inside it may know a use case, a vendor or a transport. Dependencies point inward."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/shared/src/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@intentra/**"],
                "message": "The shared kernel is the bottom of the stack and depends on nothing in the workspace."
              },
              {
                "group": ["**/infrastructure/**", "**/presentation/**"],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/adapters/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@intentra/**", "!@intentra/shared"],
                "message": "A technical adapter may depend only on the shared kernel. It knows a vendor, not a domain."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/adapters/*/src/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@intentra/**", "!@intentra/shared"],
                "message": "A technical adapter may depend only on the shared kernel. It knows a vendor, not a domain."
              },
              {
                "group": ["**/infrastructure/**", "**/presentation/**"],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/contracts/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/common-contracts"
                ],
                "message": "A published language may depend only on the shared kernel and the common contracts. A contract that reaches for a runtime dependency is no longer a wire contract."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/api-ports/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**"
                ],
                "message": "The client ports are the published API seen from outside: contracts and the shared kernel, nothing else. Never a context package."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/gateway/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/api-ports",
                  "!@intentra/adapter-*"
                ],
                "message": "A facade is a driving adapter: it speaks a transport and calls the client ports. It never imports a context package - the composition root binds the implementation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/gateway/src/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/api-ports",
                  "!@intentra/adapter-*"
                ],
                "message": "A facade is a driving adapter: it speaks a transport and calls the client ports. It never imports a context package - the composition root binds the implementation."
              },
              {
                "group": ["**/infrastructure/**", "**/presentation/**"],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/gateway/src/presentation/**/rest/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/api-ports",
                  "!@intentra/adapter-*"
                ],
                "message": "A facade is a driving adapter: it speaks a transport and calls the client ports. It never imports a context package - the composition root binds the implementation."
              },
              {
                "group": ["**/mcp/**", "**/graphql/**", "**/mcp.controller*"],
                "message": "Transports stand next to each other, not on top of each other. What they share is authentication, and it lives in infrastructure/common - not in the neighbour."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "libs/gateway/src/presentation/**/mcp/**/*.ts",
        "libs/gateway/src/presentation/mcp.controller.ts",
        "libs/gateway/src/infrastructure/mcp/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/api-ports",
                  "!@intentra/adapter-*"
                ],
                "message": "A facade is a driving adapter: it speaks a transport and calls the client ports. It never imports a context package - the composition root binds the implementation."
              },
              {
                "group": ["**/rest/**", "**/graphql/**"],
                "message": "Transports stand next to each other, not on top of each other. What they share is authentication, and it lives in infrastructure/common - not in the neighbour."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["contexts/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/api-ports",
                  "!@intentra/adapter-*"
                ],
                "message": "A context may depend only on contracts, the shared kernel, technical adapters and the client ports. It never imports a neighbour's package: it asks the neighbour through its client port when it needs an answer, and tells the world what happened through published events (ADR 0007)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "contexts/*/src/domain/**/*.ts",
        "contexts/*/src/subdomains/*/domain/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/adapter-*"
                ],
                "message": "The domain may depend only on contracts, the shared kernel and technical adapters. A client port is not among them: calling a neighbour is a use case, not something an entity does."
              },
              {
                "group": [
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "The domain is the centre of the hexagon: nothing inside it may know a use case, a vendor or a transport. Dependencies point inward."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "contexts/*/src/application/**/*.ts",
        "contexts/*/src/subdomains/*/application/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@intentra/**",
                  "!@intentra/shared",
                  "!@intentra/*-contracts",
                  "!@intentra/*-contracts/**",
                  "!@intentra/api-ports",
                  "!@intentra/adapter-*"
                ],
                "message": "A context may depend only on contracts, the shared kernel, technical adapters and the client ports. It never imports a neighbour's package: it asks the neighbour through its client port when it needs an answer, and tells the world what happened through published events (ADR 0007)."
              },
              {
                "group": ["**/infrastructure/**", "**/presentation/**"],
                "message": "The application layer declares ports; it does not reach for the adapters that implement them. The module wires them together."
              }
            ]
          }
        ]
      }
    }
  ]
}
