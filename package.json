{
  "name": "intentra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nx run-many -t watch dev -p tag:deployment:monolith",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "lint": "oxlint --no-error-on-unmatched-pattern apps/ contexts/ libs/",
    "prettier": "prettier --write \"{apps,contexts,libs}/**/*.{ts,tsx,json}\"",
    "prettier:check": "prettier --check \"{apps,contexts,libs}/**/*.{ts,tsx,json}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "catalog:tooling",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "^23.2.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "lint-staged": {
    "**/!(*.generated).{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ]
  }
}